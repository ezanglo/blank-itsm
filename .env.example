# =============================================================================
# Database
# =============================================================================
# Local Postgres / docker-compose (default dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blank_itsm

# Neon migrate only (direct / non-pooled owner URL) — never commit; do not set on Vercel runtime
# DATABASE_URL_DIRECT=postgresql://owner:...@ep-....neon.tech/neondb?sslmode=require

# Vercel runtime (Neon free smoke): pooled URL as non-superuser itsm_app — see docs/scripts/NEON_MIGRATE_AND_SEED.md
# DATABASE_URL=postgresql://itsm_app:...@ep-....-pooler.neon.tech/neondb?sslmode=require

# Optional: restricted role for RLS tests (local 0006 migration / Vitest) — not required on Vercel if DATABASE_URL is itsm_app
# ITSM_APP_DATABASE_URL=postgresql://itsm_app:itsm_app_test@localhost:5432/blank_itsm

# =============================================================================
# Better Auth — names match lib/auth/settings.ts and lib/auth/index.ts
# =============================================================================
# Required in all environments (lib/auth/index.ts throws if missing)
BETTER_AUTH_SECRET=your-secret-key-change-this-in-production-min-32-chars

# Canonical public base URL (required at runtime when NODE_ENV=production)
BETTER_AUTH_URL=http://localhost:43123
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:43123

# Production runtime: comma-separated full HTTPS URLs (required when NODE_ENV=production)
# Alias supported: TRUSTED_ORIGINS (used only if BETTER_AUTH_TRUSTED_ORIGINS is empty)
# BETTER_AUTH_TRUSTED_ORIGINS=https://your-project.vercel.app
# TRUSTED_ORIGINS=https://your-project.vercel.app

# Optional: comma-separated host patterns for dynamic baseURL (prod defaults to hostname of BETTER_AUTH_URL)
# BETTER_AUTH_ALLOWED_HOSTS=your-project.vercel.app

# H7 smoke deploy: set false on Vercel unless CoS confirms proxy trust (unset = trust proxy headers)
BETTER_AUTH_TRUSTED_PROXY_HEADERS=true

# Vercel / production example (do not commit real secrets):
# BETTER_AUTH_URL=https://your-project.vercel.app
# NEXT_PUBLIC_BETTER_AUTH_URL=https://your-project.vercel.app
# BETTER_AUTH_TRUSTED_ORIGINS=https://your-project.vercel.app
# BETTER_AUTH_TRUSTED_PROXY_HEADERS=false

# =============================================================================
# App
# =============================================================================
NODE_ENV=development

# Set by Next during `next build` only — do not set in Vercel env UI
# NEXT_PHASE=phase-production-build

# M4 local-first storage (no S3)
ATTACHMENT_STORAGE_DIR=.data/attachments
EMAIL_MOCK_DIR=.data/email-outbox

# =============================================================================
# Omit for free-tier smoke deploy (mock outbox only — no Resend)
# =============================================================================
# RESEND_API_KEY=
# EMAIL_FROM=
