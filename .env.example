# Database (local Postgres or docker-compose — no paid Neon required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blank_itsm

# Better Auth — development / Cursor Preview (see FOUNDER_PREVIEW.md)
BETTER_AUTH_SECRET=your-secret-key-change-this-in-production
BETTER_AUTH_URL=http://localhost:43123
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:43123
# Optional in development: comma-separated extra trusted origins (full URLs)
# BETTER_AUTH_TRUSTED_ORIGINS=https://your-preview.example.com
# Alias supported in production: TRUSTED_ORIGINS=https://app.example.com
# Optional: override allowed host patterns for dynamic baseURL (development defaults include localhost + *.cursor.com)
# BETTER_AUTH_ALLOWED_HOSTS=localhost,127.0.0.1,*.cursor.com
# Set to false only if you are not behind a trusted preview proxy
# BETTER_AUTH_TRUSTED_PROXY_HEADERS=true

# Production (NODE_ENV=production) — required; wide dev defaults are NOT applied:
# BETTER_AUTH_URL=https://app.example.com
# NEXT_PUBLIC_BETTER_AUTH_URL=https://app.example.com
# BETTER_AUTH_TRUSTED_ORIGINS=https://app.example.com
# BETTER_AUTH_ALLOWED_HOSTS=app.example.com

# App
NODE_ENV=development

# M4 local-first storage (no S3)
ATTACHMENT_STORAGE_DIR=.data/attachments
EMAIL_MOCK_DIR=.data/email-outbox
# Optional production email (not used in dev)
# RESEND_API_KEY=
# EMAIL_FROM=noreply@yourdomain.com

# Non-superuser DB role for RLS realism in tests (see FOUNDER_PREVIEW.md § itsm_app)
# Vitest sets this automatically when migration 0006_itsm_app_role.sql is applied.
# ITSM_APP_DATABASE_URL=postgresql://itsm_app:itsm_app_test@localhost:5432/blank_itsm
